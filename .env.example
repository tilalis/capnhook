# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to use the bot
TELEGRAM_WHITELIST=123456789

# Transmission RPC endpoint (optional, defaults to http://192.168.1.42:9091/transmission/rpc)
TRANSMISSION_RPC_URL=http://192.168.1.42:9091/transmission/rpc

# Root media directory holding Movies/ and TVShows/ (optional, defaults to /home/tilalis/Plex)
PLEX_ROOT_DIR=/home/user/Plex
