# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to use the bot
TELEGRAM_WHITELIST=123456789

# Transmission RPC endpoint (optional, defaults to http://192.168.1.42:9091/transmission/rpc)
TRANSMISSION_RPC_URL=http://192.168.1.42:9091/transmission/rpc

# Root media directory holding Movies/ and TVShows/ 
PLEX_ROOT_DIR=/home/user/Plex

# Max number of search results shown per query (optional, defaults to 30)
SEARCH_MAX_RESULTS=30

# Torrent search backend: "apibay" (default) or "internetarchive".
# "internetarchive" searches archive.org for movies under a permissible
# license only (Creative Commons or public domain).
SEARCH_CLIENT=apibay

# --- Serving mode ---------------------------------------------------------
# Leave TELEGRAM_WEBHOOK_URL empty to receive updates with long polling.
# Set it to the public https url Telegram should push updates to in order to
# switch the bot into webhook mode.
TELEGRAM_WEBHOOK_URL=

# Address the webhook server listens on (optional, defaults to :8080)
TELEGRAM_WEBHOOK_ADDR=:8080

# Local path to serve the webhook on (optional, defaults to the path of
# TELEGRAM_WEBHOOK_URL). Only needed when a proxy rewrites the path.
TELEGRAM_WEBHOOK_PATH=

# Shared secret Telegram sends back in X-Telegram-Bot-Api-Secret-Token.
# Optional, but strongly recommended: without it anyone who guesses the url
# can feed updates to the bot.
TELEGRAM_WEBHOOK_SECRET=
