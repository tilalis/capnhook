# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to use the bot
TELEGRAM_WHITELIST=123456789

# Transmission RPC endpoint (optional, defaults to http://192.168.1.42:9091/transmission/rpc)
TRANSMISSION_RPC_URL=http://192.168.1.42:9091/transmission/rpc

# Root media directory holding Movies/ and TVShows/ 
PLEX_ROOT_DIR=/home/user/Plex

# Max number of search results shown per query (optional, defaults to 30)
SEARCH_MAX_RESULTS=30

# Torrent search backend: "apibay" (default) or "internetarchive".
# "internetarchive" searches archive.org for movies under a permissible
# license only (Creative Commons or public domain).
SEARCH_CLIENT=apibay
